---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" class:list={['logo', className]}>
  <!-- The device mark: Rory's logo (2026-10-28), a landscape rugged tablet with chamfered corners, as a transparent
       webp at 3x header size. The favicons in public/ are the same mark. -->
  <img class="logo-mark" src="/logo.webp" width="137" height="96" alt="" />
  <span class="logo-text">
    <span class="logo-word"><strong>explosionprooftablets</strong>.com</span>
    <span class="logo-tagline">ATEX Zone 1 &amp; 2 Tablets Compared</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    min-width: 0;
    color: var(--color-ink);
    text-decoration: none;
  }

  .logo-mark {
    flex: none;
    width: auto;
    height: 1.625rem;
  }

  .logo-text {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-heading);
    white-space: nowrap;
  }
  .logo-word strong { font-weight: 700; }

  .logo-tagline {
    font-family: var(--font-sans);
    font-size: 0.65625rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (min-width: 30rem) {
    /* About the area of the phones site's 2.5rem portrait mark, a little larger, now that the device is landscape */
    .logo-mark { height: 1.8rem; }
    .logo-word { font-size: 1.0625rem; }
    .logo-tagline { font-size: 0.6875rem; }
  }
</style>
