---
import { getCollection } from 'astro:content';
import InfoPage from '../components/InfoPage.astro';
import { CONTACT } from '../config/site';
import { BEST_PAGES } from '../data/best-pages';
import { COMPARE_PAGES } from '../data/compare-pages';
import { GUIDE_PAGES } from '../data/guide-pages';

const tablets = await getCollection('tablets');
const brands = new Set(tablets.map((p) => p.data.brand)).size;

// Only what exists: the Best for pages, head-to-heads and guides are written in later phases
const helpers = [
  COMPARE_PAGES.length && `${COMPARE_PAGES.length} head-to-head comparison${COMPARE_PAGES.length === 1 ? '' : 's'}`,
  BEST_PAGES.length && `${BEST_PAGES.length} ranking${BEST_PAGES.length === 1 ? '' : 's'} by zone, industry and use case, each stating the criteria behind it`,
  GUIDE_PAGES.length && `${GUIDE_PAGES.length} guide${GUIDE_PAGES.length === 1 ? '' : 's'}`,
].filter((h): h is string => Boolean(h));
const helperList = helpers.length > 1 ? `${helpers.slice(0, -1).join(', ')} and ${helpers.at(-1)}` : (helpers[0] ?? '');
const helperText = helpers.length ? '<p>To help with the decision there ' + (/^1 /.test(helpers[0]) ? 'is ' : 'are ') + helperList + '.</p>' : '';

const sections = [
  {
    heading: 'Why we created this site',
    html: `<p>Choosing a tablet for a hazardous area means reading certificates. The zones, gas group, temperature class and conditions of use sit in ATEX and IECEx documents and makers' datasheets, each brand publishes them in its own format, and comparing two tablets properly can take an afternoon with a spreadsheet.</p>
<p>We built explosionprooftablets.com to put that information in one place. It covers ${tablets.length} tablets, rugged Ex tablets and tablet Ex cases from ${brands} brands, current and discontinued, and each one has its own page with its Ex marking decoded, the conditions on its certificate, its full specifications and, for cases, what still works through the case.</p>
<p>The site covers both routes into Zone 1 and Zone 2: dedicated Ex tablets and hazardous-area versions of rugged tablets, and standard iPads, Samsung Galaxy tablets and other consumer tablets in certified Ex cases or conversions. Both are described by the same rules, so a team can weigh them against each other on equal terms.</p>
${helperText}
<p>Everything is checked against primary sources, and anything we could not confirm is marked as not verified. <a href="/how-we-rate/">How we rate</a> sets out the rules.</p>`,
  },
  {
    heading: 'Get in touch',
    html: `<p>For price and availability, help choosing a tablet, or a fact that needs correcting, <a href="${CONTACT.href}">contact us</a>. We reply by email.</p>`,
  },
];

---

<InfoPage
  path="/about/"
  title="About Intrinsically Safe Tablets"
  description="Why we built explosionprooftablets.com and what it covers: tablet pages, head-to-head comparisons and rankings for ATEX Zone 1 and Zone 2."
  h1="About us"
  lead="An independent place to research and compare tablets for hazardous areas, built on certificates rather than marketing claims."
  sections={sections}
/>
