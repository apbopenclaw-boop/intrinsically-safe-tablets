---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';

/*
 * The contact form replaces the one on the legacy home page (/#contact) and must keep working the same way:
 * Web3Forms JSON API, the same access key, subject, sender name and field names (name, email, company, message,
 * page), the "_honey" spam trap, and the same messages. Price links arrive as ?tablet=<slug> (new pages) or
 * ?inquire=<product> (legacy pages) and pre-fill the message. The tablet requirements fields come from the legacy
 * "Help me choose a tablet" quiz (PR #9): required_zone, operating_system, use, country, quantity, plus language and
 * cta_source ("homepage-requirements" when the home page card sent the visitor, else "contact"). The card passes
 * ?zone=, ?os= and ?source=.
 */
const tablets = await getCollection('tablets');
const tabletNames = Object.fromEntries(tablets.map((p) => [p.id, p.data.name]));

const title = 'Contact Us: Prices, Advice and Corrections';
const description =
  'Ask about price and availability, get impartial help choosing a hazardous-area tablet, or tell us about a fact that needs correcting. We reply by email.';
if (title.length > 60 || description.length > 160) throw new Error('Contact page title or description is too long');
const url = `${SITE.url}/contact/`;

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Home', item: `${SITE.url}/` },
      { name: 'Contact', item: url },
    ].map((b, i) => ({ '@type': 'ListItem', position: i + 1, ...b })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="contact-hero" aria-labelledby="contact-title">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact', href: '' }]} />
      <h1 id="contact-title">Contact us</h1>
      <p class="lead">
        Price and availability, device selection, deployment planning, or a question about the data on this site. We reply
        by email.
      </p>
    </div>
  </section>

  <section class="band band-white" aria-label="Contact form">
    <div class="container">
      <div class="contact-card">
        <form
          class="contact-form"
          data-contact-form
          data-key={SITE.web3formsKey}
          data-subject="explosionprooftablets.com enquiry"
          data-tablets={JSON.stringify(tabletNames)}
          novalidate
        >
          <fieldset class="req-fields" id="tablet-requirements">
            <legend tabindex="-1" id="requirements-focus">Your tablet requirements <span class="optional">(optional)</span></legend>
            <p class="req-note">Requirements help us answer your enquiry. Suitability must be checked against the exact certificate and site conditions.</p>
            <div class="row">
              <div class="field-wrap">
                <label for="req-zone">Required zone</label>
                <select id="req-zone" name="required_zone">
                  <option value="Not sure">Not sure</option>
                  <option value="Zone 1">Zone 1</option>
                  <option value="Zone 2">Zone 2</option>
                </select>
              </div>
              <div class="field-wrap">
                <label for="req-os">Operating system</label>
                <select id="req-os" name="operating_system">
                  <option value="No preference">No preference</option>
                  <option value="iPadOS">iPadOS</option>
                  <option value="Android">Android</option>
                  <option value="Windows">Windows</option>
                </select>
              </div>
            </div>
            <div class="field-wrap">
              <label for="req-use">Intended use</label>
              <input id="req-use" type="text" name="use" maxlength="300" />
            </div>
            <div class="row">
              <div class="field-wrap">
                <label for="req-country">Country of use</label>
                <input id="req-country" type="text" name="country" maxlength="300" autocomplete="country-name" />
              </div>
              <div class="field-wrap">
                <label for="req-quantity">Quantity</label>
                <input id="req-quantity" type="number" name="quantity" min="1" max="100000" step="1" inputmode="numeric" />
              </div>
            </div>
          </fieldset>
          <input type="hidden" name="language" value="en" />
          <input type="hidden" name="cta_source" value="contact" data-cta-source />

          <div class="row">
            <div class="field-wrap">
              <label for="cf-name">Name</label>
              <input id="cf-name" type="text" name="name" autocomplete="name" required />
            </div>
            <div class="field-wrap">
              <label for="cf-email">Work email</label>
              <input id="cf-email" type="email" name="email" autocomplete="email" required />
            </div>
          </div>
          <div class="field-wrap">
            <label for="cf-company">Company <span class="optional">(optional)</span></label>
            <input id="cf-company" type="text" name="company" autocomplete="organization" />
          </div>
          <div class="field-wrap">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="6" required></textarea>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="cf-hp">Leave empty</label>
            <input class="hp-input" id="cf-hp" type="text" name="_honey" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" class="btn btn-primary">Send message</button>
          <p class="small">
            We use your details only to answer you. See the <a href="/privacy.html">privacy notice</a>.
          </p>
        </form>
        <p class="form-status" data-form-status hidden></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const ENDPOINT = 'https://api.web3forms.com/submit';
  const TIMEOUT_MS = 15000;
  const T = {
    sending: 'Sending…',
    required: 'Please fill in this field.',
    email: 'Please enter a valid email address, like name@company.com.',
    fail: 'Could not send. Check your connection and try again.',
    ok: 'Thanks. We will reply by email.',
    inquire: 'Price and availability request: ',
    quantity: 'Enter a whole quantity between 1 and 100000.',
  };

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form) {
    type Field = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    // Every named field is sent; only visible ones are validated
    const sent = [...form.querySelectorAll<Field>('input, textarea, select')].filter(
      (f) => f.name && !f.classList.contains('hp-input'),
    );
    const fields = sent.filter((f) => f.type !== 'hidden');
    const btn = form.querySelector<HTMLButtonElement>('[type=submit]');
    const label = btn?.innerHTML ?? '';

    // Pre-fill from a price link: ?tablet=<slug> (new pages) or ?inquire=<product> (legacy pages)
    const params = new URLSearchParams(location.search);
    const names: Record<string, string> = JSON.parse(form.dataset.tablets || '{}');
    const product = names[params.get('tablet') ?? ''] ?? params.get('inquire');
    const msg = form.querySelector<HTMLTextAreaElement>('textarea[name=message]');
    if (product && msg && !msg.value) msg.value = T.inquire + product.slice(0, 80) + '\n\n';

    // From the home page's "Help me choose a tablet" card: ?zone=, ?os= and ?source= pre-fill the requirements
    const pick = (id: string, value: string | null) => {
      const sel = form.querySelector<HTMLSelectElement>(`#${id}`);
      if (sel && value && [...sel.options].some((o) => o.value === value)) sel.value = value;
    };
    pick('req-zone', params.get('zone'));
    pick('req-os', params.get('os'));
    const source = params.get('source');
    const sourceField = form.querySelector<HTMLInputElement>('[data-cta-source]');
    if (sourceField && source && /^[a-z0-9-]{1,40}$/.test(source)) sourceField.value = source;
    if (source === 'homepage-requirements') {
      document.getElementById('tablet-requirements')?.scrollIntoView({ block: 'start' });
      document.getElementById('requirements-focus')?.focus({ preventScroll: true });
    }

    const errorFor = (f: Field) => {
      const v = f.value.trim();
      if (f.required && !v) return T.required;
      if (v && f.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) return T.email;
      if (v && f.name === 'quantity' && !(/^\d+$/.test(v) && +v >= 1 && +v <= 100000)) return T.quantity;
      return '';
    };
    const showError = (f: Field, message: string) => {
      const id = `${f.id}-err`;
      let el = document.getElementById(id);
      if (!message) {
        f.removeAttribute('aria-invalid');
        if (el) el.hidden = true;
        return;
      }
      if (!el) {
        el = document.createElement('p');
        el.className = 'field-error';
        el.id = id;
        f.insertAdjacentElement('afterend', el);
        f.setAttribute('aria-describedby', id);
      }
      el.textContent = message;
      el.hidden = false;
      f.setAttribute('aria-invalid', 'true');
    };

    form.addEventListener('input', (e) => {
      const f = e.target as HTMLInputElement;
      if (f.getAttribute('aria-invalid') === 'true') showError(f, errorFor(f));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let bad: HTMLElement | null = null;
      for (const f of fields) {
        const m = errorFor(f);
        showError(f, m);
        if (m && !bad) bad = f;
      }
      if (bad) return bad.focus();
      const hp = form.querySelector<HTMLInputElement>('.hp-input');
      if (hp?.value) return; // spam trap

      const data: Record<string, string> = {
        access_key: form.dataset.key ?? '',
        subject: form.dataset.subject ?? 'explosionprooftablets.com enquiry',
        from_name: 'explosionprooftablets.com',
        page: location.href,
      };
      for (const f of sent) data[f.name] = f.value;

      if (btn) {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = T.sending;
      }
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS); // never hang on "Sending…"
      try {
        const r = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
          signal: ctrl.signal,
        });
        const j = await r.json();
        if (!j || String(j.success) !== 'true') throw new Error(j?.message || 'send failed');
        form.hidden = true;
        // Same conversion event as the legacy site's form
        const w = window as unknown as { gtag?: (...args: unknown[]) => void };
        w.gtag?.('event', 'generate_lead', { event_category: 'contact', event_label: data.subject, cta_source: data.cta_source });
        if (status) {
          status.className = 'form-status form-status--ok';
          status.setAttribute('role', 'status');
          status.textContent = T.ok;
          status.hidden = false;
          status.tabIndex = -1;
          status.focus();
        }
      } catch (err) {
        console.warn('Form not sent:', (err as Error)?.message);
        if (status) {
          status.className = 'form-status form-status--error';
          status.setAttribute('role', 'alert');
          status.textContent = T.fail;
          status.hidden = false;
        }
      } finally {
        clearTimeout(timer);
        if (btn) {
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          btn.innerHTML = label;
        }
      }
    });
  }
</script>

<style>
  .contact-hero {
    padding-block: 0.5rem 3.5rem;
    background:
      radial-gradient(1200px 600px at 80% -10%, rgb(245 158 11 / 0.06), transparent 60%),
      radial-gradient(1000px 500px at 10% 30%, rgb(34 197 94 / 0.05), transparent 55%),
      var(--paper-grain);
    background-size: auto, auto, 3px 3px;
  }
  .contact-hero h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-hero);
  }
  .contact-hero .lead { max-width: 40rem; margin-top: 1.25rem; }

  .contact-card { max-width: 42rem; }
  .contact-form { display: grid; gap: 1.25rem; }
  .row { display: grid; gap: 1.25rem; }
  .field-wrap { display: grid; gap: 0.4rem; }
  label { font-weight: 600; font-size: var(--text-sm); }
  .optional { font-weight: 400; color: var(--color-text-muted, #5b5b5b); }
  input,
  textarea,
  select {
    width: 100%;
    min-height: 44px;
    padding: 0.65rem 0.85rem;
    font: inherit;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    background: #fff;
  }
  textarea { resize: vertical; }
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible { outline: 2px solid var(--color-forest); outline-offset: 1px; }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] { border-color: #b42318; }
  .contact-form :global(.field-error) { color: #b42318; font-size: var(--text-sm); }
  .contact-form .btn { justify-self: start; }
  .small { font-size: 0.8rem; }
  .small a { color: var(--color-forest); }
  .req-fields {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid var(--color-panel-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .req-fields legend { padding: 0 0.375rem; font-weight: 600; }
  .req-fields legend:focus { outline: none; }
  .req-note { font-size: var(--text-sm); color: var(--color-muted); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .form-status { padding: 1rem 1.25rem; border-radius: 6px; max-width: 42rem; }
  .form-status:global(.form-status--ok) { background: #ecf6ef; color: #14532d; }
  .form-status:global(.form-status--error) { margin-top: 1rem; background: #fdecea; color: #8a1c13; }

  @media (min-width: 40rem) {
    .row { grid-template-columns: 1fr 1fr; }
  }
</style>
